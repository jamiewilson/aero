# Aero build-time vars (Node / Vite plugin — not exposed to the browser unless you add VITE_*).
# Copy to `.env.local` for personal overrides (gitignored).
#
# Profiles (committed in this repo): use `vp build --mode <name>` to load `.env.<name>`.

# AERO_INCREMENTAL=1
# AERO_LOG=debug
# AERO_SERVER=false
