{
	"name": "single-bundle",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp build && vp preview",
		"fmt": "vp fmt . && prettier --write \"**/*.html\"",
		"fmt:check": "vp fmt --check . && prettier --check \"**/*.html\""
	},
	"dependencies": {
		"@aero-js/core": "workspace:*",
		"alpinejs": "^3.15.12",
		"htmx.org": "^2.0.10"
	},
	"devDependencies": {
		"@aero-js/prettier-plugin-aero": "workspace:*",
		"prettier": "^3.9.3",
		"@types/alpinejs": "^3.13.11",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
